{
  "name": "oil.chrome",
  "version": "0.1.0",
  "private": true,
  "description": "Edit Chrome windows, tab groups, tabs and bookmarks as one vim-editable outline",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "e2e": "node scripts/build.mjs && node --test --test-concurrency=1 --test-timeout=120000 \"test/e2e/**/*.test.mjs\"",
    "demo": "node scripts/build.mjs && node scripts/demo.mjs",
    "record": "node scripts/build.mjs && node scripts/record.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-vim": "^6.4.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  }
}
