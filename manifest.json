{
  "manifest_version": 3,
  "name": "oil.chrome",
  "version": "0.1.0",
  "description": "Edit windows, tab groups, tabs and bookmarks as one vim-style outline.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "bookmarks", "storage", "favicon"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "oil.chrome — edit tabs and bookmarks" },
  "commands": {
    "open-editor": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Open the oil.chrome editor"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
